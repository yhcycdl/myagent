# Copy this file to .env.local and fill in your private values.
# .env.local is ignored by git.

AGENT_LLM_API_KEY=replace_with_your_api_key

# OpenAI-compatible MiMo endpoint.
AGENT_LLM_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
AGENT_LLM_MODEL=MiMo-V2.5-Pro
AGENT_LLM_MAX_TOKENS=1024
AGENT_LLM_TEMPERATURE=0
AGENT_LLM_REASONING_EFFORT=none
AGENT_LLM_ALLOW_REASONING_CONTENT_AS_TEXT=1

# Optional: use Omni if you want one model for both text and image understanding.
# AGENT_LLM_MODEL=MiMo-V2-Omni

# Safe defaults for full evaluation.
AGENT_LLM_ENABLED=1
AGENT_LLM_POLISH_ENABLED=1
AGENT_LLM_VERIFY_ENABLED=1
AGENT_LLM_FINAL_GENERATION_ENABLED=0
AGENT_LLM_QUERY_PLANNER_ENABLED=0
AGENT_LLM_VISION_ENABLED=1

# Local reranker service.
AGENT_RERANK_ENABLED=1
AGENT_RERANK_BASE_URL=http://127.0.0.1:8003/v1
AGENT_RERANK_MODEL=bge-reranker-v2-m3
AGENT_RERANK_API_KEY=EMPTY
AGENT_RERANK_TOP_N=15
AGENT_RERANK_MAX_CANDIDATES=24

WEAK_EVIDENCE_FALLBACK_ENABLED=1
